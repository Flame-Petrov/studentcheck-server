PORT=3000
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
STRIPE_SECRET_KEY=
APP_URL=

# 32-byte key (hex or base64) for AES-256-GCM at-rest encryption helpers.
ENCRYPTION_KEY=

# 32-byte key (hex or base64) for deterministic lookup HMACs.
LOOKUP_HASH_KEY=

# Application pepper used with password hashing/verification.
AUTH_PEPPER=

APPLY_ENCRYPTION_MIGRATION=false
APPLY_ENCRYPTION_BACKFILL=false
